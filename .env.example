# Token del bot entregado por @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Puerto del servidor de health-check (Render lo inyecta automaticamente)
PORT=3000

# Base publica usada para construir el enlace final del video
PUBLIC_BASE_URL=https://tu-servicio.onrender.com/videos

# Tamano maximo aceptado en MB (Telegram limita la descarga a 20 MB por getFile)
MAX_VIDEO_MB=20
